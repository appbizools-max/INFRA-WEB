# Backend Server Port
PORT=5000

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infraops360

# Resend API Key for Email OTP Delivery
RESEND_API_KEY=your_resend_api_key_here

# Firebase Admin SDK Service Account Path (Optional for production token minting)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
