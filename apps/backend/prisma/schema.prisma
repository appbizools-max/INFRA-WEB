generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model platform_config {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trial_days             Int?      @default(14)
  starter_fee            Decimal?  @default(2999) @db.Decimal
  professional_fee       Decimal?  @default(9999) @db.Decimal
  enterprise_fee         Decimal?  @default(24999) @db.Decimal
  corporate_fee          Decimal?  @default(49999) @db.Decimal
  starter_free_tons      Int?      @default(2500)
  professional_free_tons Int?      @default(25000)
  enterprise_free_tons   Int?      @default(100000)
  corporate_free_tons    Int?      @default(500000)
  starter_equipment      Int?      @default(5)
  professional_equipment Int?      @default(20)
  enterprise_equipment   Int?      @default(50)
  corporate_equipment    Int?      @default(100)
  overage_ton_rate       Decimal?  @default(0.50) @db.Decimal
  overage_equipment_rate Decimal?  @default(500) @db.Decimal
  updated_by             String?   @db.Uuid
  updated_at             DateTime? @default(now()) @db.Timestamp(6)
  users                  users?    @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model subscriptions {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String?     @db.Uuid
  plan                 plan_type?
  amount               Decimal?    @db.Decimal
  billing_period_start DateTime?   @db.Timestamp(6)
  billing_period_end   DateTime?   @db.Timestamp(6)
  status               sub_status? @default(pending)
  razorpay_payment_id  String?     @db.VarChar(100)
  paid_at              DateTime?   @db.Timestamp(6)
  created_at           DateTime?   @default(now()) @db.Timestamp(6)
  tenants              tenants?    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model tenant_vendor_requests {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String?         @db.Uuid
  vendor_id    String?         @db.Uuid
  requested_by String?         @db.Uuid
  status       request_status? @default(pending)
  message      String?
  responded_at DateTime?       @db.Timestamp(6)
  created_at   DateTime?       @default(now()) @db.Timestamp(6)
  users        users?          @relation(fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants      tenants?        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendors      vendors?        @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model tenants {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_name             String                   @db.VarChar(200)
  company_email            String?                  @unique @db.VarChar(200)
  company_mobile           String?                  @unique @db.VarChar(15)
  gstin                    String?                  @db.VarChar(15)
  pan                      String?                  @db.VarChar(10)
  industry_type            String?                  @db.VarChar(50)
  address                  String?
  logo_url                 String?
  plan                     plan_type?               @default(starter)
  status                   tenant_status?           @default(trial)
  trial_start_date         DateTime?                @default(now()) @db.Timestamp(6)
  trial_end_date           DateTime?                @db.Timestamp(6)
  subscription_start       DateTime?                @db.Timestamp(6)
  next_billing_date        DateTime?                @db.Timestamp(6)
  razorpay_customer_id     String?                  @db.VarChar(100)
  razorpay_subscription_id String?                  @db.VarChar(100)
  created_at               DateTime?                @default(now()) @db.Timestamp(6)
  updated_at               DateTime?                @default(now()) @db.Timestamp(6)
  subscriptions            subscriptions[]
  tenant_vendor_requests   tenant_vendor_requests[]
  users                    users[]
}

model users {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  infraops_id            String                   @unique @db.VarChar(20)
  firebase_uid           String?                  @unique @db.VarChar(128)
  tenant_id              String?                  @db.Uuid
  user_type              user_type_enum?          @default(tenant_user)
  role                   String?                  @db.VarChar(50)
  full_name              String                   @db.VarChar(200)
  mobile                 String                   @unique @db.VarChar(15)
  email                  String?                  @unique @db.VarChar(200)
  department             String?                  @db.VarChar(100)
  designation            String?                  @db.VarChar(100)
  status                 user_status?             @default(active)
  profile_photo_url      String?
  aadhaar_url            String?
  pan_url                String?
  driving_license_url    String?
  bank_account_number    String?                  @db.VarChar(20)
  bank_ifsc              String?                  @db.VarChar(11)
  bank_name              String?                  @db.VarChar(100)
  joining_date           DateTime?                @db.Date
  date_of_birth          DateTime?                @db.Date
  address                String?
  created_by             String?                  @db.Uuid
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  updated_at             DateTime?                @default(now()) @db.Timestamp(6)
  platform_config        platform_config[]
  tenant_vendor_requests tenant_vendor_requests[]
  users                  users?                   @relation("usersTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_users            users[]                  @relation("usersTousers")
  tenants                tenants?                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendors                vendors[]
}

model vendors {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String?                  @db.Uuid
  company_name           String?                  @db.VarChar(200)
  gstin                  String?                  @db.VarChar(15)
  pan                    String?                  @db.VarChar(10)
  vendor_type            vendor_type_enum?
  service_areas          String[]
  fleet_count            Int?
  status                 vendor_status?           @default(pending_verification)
  bank_account_number    String?                  @db.VarChar(20)
  bank_ifsc              String?                  @db.VarChar(11)
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  tenant_vendor_requests tenant_vendor_requests[]
  users                  users?                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum plan_type {
  starter
  professional
  enterprise
  corporate
}

enum request_status {
  pending
  accepted
  rejected
}

enum sub_status {
  paid
  pending
  failed
  refunded
}

enum tenant_status {
  trial
  active
  suspended
  locked
  cancelled
}

enum user_status {
  active
  suspended
  deactivated
}

enum user_type_enum {
  tenant_user
  vendor
  client
  saas_admin
}

enum vendor_status {
  active
  suspended
  pending_verification
}

enum vendor_type_enum {
  transporter
  equipment
  labour
  subcontractor
  fuel
}
